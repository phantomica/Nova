{
  "name": "nova-desktop-ai",
  "productName": "Nova",
  "version": "0.1.0",
  "private": true,
  "author": "Nova contributors",
  "description": "A local-first desktop voice assistant powered by Ollama.",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:app-icon": "node scripts/build-windows-icon.cjs",
    "package:win": "npm run build && npm run build:app-icon && electron-forge package --platform win32",
    "make:win": "npm run build && npm run build:app-icon && electron-forge make --platform win32",
    "prestart": "node scripts/ensure-electron.cjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.7.0",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
